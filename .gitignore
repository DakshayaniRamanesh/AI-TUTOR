# =============================================================================
# Kestrel .gitignore
# =============================================================================

# ── Environment Variables, Secrets & Credentials ──────────────────────────────
.env
.env.local
.env.*.local
*.env
backend/.env
*.pem
*.key
*.cert
firebase_credentials*.json
service_account*.json

# ── Python Bytecode, Caches & Virtual Environments ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
venv313/

# ── Database & Local App Storage ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
storage_data/
downloads/
qdrant_data/
qdrant_storage/

# ── Node.js / Frontend (legacy & dependencies) ────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
build/
dist/
*.log

# ── Manim, Generated Video & Audio Media ──────────────────────────────────────
media/
_manim_output/
opengl_test/
smoke_media/
partial_movie_files/
backend/workspace/videos/
*.mp4
*.avi
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.m4a
*.aac
*.flac

# ── LaTeX & Document Engine Artifacts ─────────────────────────────────────────
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.toc
*.nav
*.snm
*.vrb
_minted*

# ── Test Artifacts & Temporary Files ──────────────────────────────────────────
tmp/
scratch/
*.tmp
*.bak
*.swp
*.swo
*~
test_*.txt
test_scene.py
backend/tests/scenario_results.json

# ── Large Binaries (download separately) ──────────────────────────────────────
tectonic.exe
tectonic
get-pip.py

# ── IDE, Editor & OS System Files ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
.antigravity/
.agents/
.modal.toml
