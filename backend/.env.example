# Google AI (Gemini) API Key — used for gemini-embedding-2 and LLM calls
GOOGLE_API_KEY=your_google_ai_api_key

# Qdrant Vector DB — collection: "manim-docs", size=3072
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key

# DigitalOcean Spaces (S3 compatible) — boto3==1.35.99 (DO not upgrade to 1.36.0)
DO_SPACES_KEY=your_spaces_key
DO_SPACES_SECRET=your_spaces_secret
DO_SPACES_BUCKET=manim-videos
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Firebase / Firestore (for persistent job state in production)
FIREBASE_CREDENTIALS_JSON={}

# Tavily Web Search API (ResearchAgent fallback for annotation queries)
TAVILY_API_KEY=your_tavily_api_key
