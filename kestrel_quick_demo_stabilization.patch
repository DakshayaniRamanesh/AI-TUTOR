+                    f"using {fallback_port}."
+                )
+                selected_port = fallback_port
+                os.environ["PORT"] = str(fallback_port)
+                config.BACKEND_URL = f"http://localhost:{fallback_port}"
+                break
+
+    uvicorn.run(app, host="0.0.0.0", port=selected_port)
